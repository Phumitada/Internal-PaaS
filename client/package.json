{
  "name": "professional-web-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional React + Express template with authentication, ready for production deployment",
  "keywords": [
    "react",
    "typescript",
    "express",
    "authentication",
    "jwt",
    "tailwindcss",
    "template",
    "portfolio",
    "professional"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
